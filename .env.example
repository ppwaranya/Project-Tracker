# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# One-time migration source: the existing Google spreadsheet ID.
# The Admin can import its Projects and Holidays into Firebase from the app.
# After migration, Firebase is the shared database; the spreadsheet is not updated.
VITE_GOOGLE_SHEETS_ID="1tnOTBo9PyEty2aW5R2fy5mVQ6HtdKPq5u4wr-ZVEzWM"

# Vercel server-only secrets for the Firebase Admin API. Never prefix these with VITE_.
# Set FIREBASE_SERVICE_ACCOUNT to the service account JSON in Vercel Project Settings.
# Set FIREBASE_PROJECT_ID to the Firebase project ID.
# Set FIREBASE_BOOTSTRAP_ADMIN_EMAIL to the Google email allowed to initialize the first Admin.
# Firestore reads are public for shared view-only links; Editor/Admin claims are required to write.
FIREBASE_SERVICE_ACCOUNT=""
FIREBASE_PROJECT_ID="gen-lang-client-0595247860"
FIREBASE_BOOTSTRAP_ADMIN_EMAIL="your-admin-google-email@example.com"
